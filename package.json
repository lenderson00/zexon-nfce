{
  "name": "zexon-nfce",
  "version": "0.1.0",
  "description": "Biblioteca TypeScript para emissão e operação diária de NFC-e (modelo 65): emissão, consulta, cancelamento, inutilização, contingência offline e DANFCE.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "schemas", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["nfce", "nfe", "sefaz", "nota-fiscal", "fiscal", "brasil"],
  "dependencies": {
    "fast-xml-parser": "^5.2.0",
    "node-forge": "^1.3.1",
    "pdfkit": "^0.17.0",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.11",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "xmllint-wasm": "^4.0.2"
  }
}
