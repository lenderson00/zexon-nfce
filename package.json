{
  "name": "@zexon/nfce",
  "version": "0.6.0",
  "description": "Biblioteca e CLI (com servidor MCP e Skill para IAs) para emissão e operação diária de NFC-e (modelo 65): emissão, consulta, cancelamento, inutilização, contingência offline/EPEC e DANFCE.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nfce": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "README.md",
    "LICENSE",
    "COPYRIGHT.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "agent",
    "ai",
    "brasil",
    "cli",
    "fiscal",
    "mcp",
    "nfce",
    "nfe",
    "nota-fiscal",
    "sefaz",
    "skill"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "fast-xml-parser": "^5.2.0",
    "node-forge": "^1.3.1",
    "pdfkit": "^0.17.0",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.11",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "pg": "^8.23.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "xmllint-wasm": "^4.0.2"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "author": "Lenderson Macedo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenderson00/zexon-nfce.git"
  },
  "homepage": "https://github.com/lenderson00/zexon-nfce#readme",
  "bugs": {
    "url": "https://github.com/lenderson00/zexon-nfce/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
